UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.P then
        getgenv().BOSS_KILL = false
        btn.Text = "BOSS KILL : OFF"
        warn("[PANIC] BOSS KILL STOPPED")
    end
end)

-- ===== CORE =====
local function isBoss(model)
    if not model then return false end
    if not model:IsA("Model") then return false end
    if not BossNames[model.Name] then return false end
    if Players:GetPlayerFromCharacter(model) then return false end
    return model:FindFirstChildOfClass("Humanoid")
end

local function killBoss(model)
    local hum = model:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health > 0 then
        hum:TakeDamage(math.huge) -- infinite damage
    end
end

